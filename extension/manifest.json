{
  "manifest_version": 3,
  "name": "Comment Cleaner for 9GAG",
  "short_name": "Comment Cleaner",
  "version": "1.0.0",
  "description": "Find all your 9GAG comments and replies, select them by date and delete them in bulk.",
  "permissions": ["scripting", "tabs", "storage", "cookies"],
  "host_permissions": ["https://*.9gag.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Comment Cleaner for 9GAG",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
